<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <linearGradient id="fgc-teal" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0B3C42"/>
      <stop offset="100%" stop-color="#051C1F"/>
    </linearGradient>
    <linearGradient id="fgc-gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F2B90C"/>
      <stop offset="100%" stop-color="#D49A00"/>
    </linearGradient>
  </defs>

  <!-- Federal Shield -->
  <path d="M 60,6 C 88,6 102,18 102,46 C 102,80 60,112 60,112 C 60,112 18,80 18,46 C 18,18 32,6 60,6 Z" fill="url(#fgc-teal)" stroke="url(#fgc-gold)" stroke-width="3"/>

  <!-- Federal Star & Crescent -->
  <path d="M 54,16 A 7,7 0 1,0 63,25 A 9,9 0 1,1 54,16 Z" fill="url(#fgc-gold)"/>
  <polygon points="63,18 64.5,21 68,21 65,23 66,26 63,24 60,26 61,23 58,21 61.5,21" fill="url(#fgc-gold)"/>

  <!-- Torch of Knowledge & Open Book -->
  <g transform="translate(60, 56)">
    <!-- Torch handle -->
    <path d="M -3,14 L 3,14 L 2,-4 L -2,-4 Z" fill="url(#fgc-gold)"/>
    <!-- Torch bowl -->
    <path d="M -7,-4 L 7,-4 L 4,-10 L -4,-10 Z" fill="url(#fgc-gold)"/>
    <!-- Flame -->
    <path d="M 0,-24 C 6,-18 7,-12 0,-8 C -7,-12 -6,-18 0,-24 Z" fill="#FF5722"/>
    <path d="M 0,-20 C 3,-16 4,-12 0,-9 C -4,-12 -3,-16 0,-20 Z" fill="#FFC107"/>
  </g>

  <!-- Text -->
  <text x="60" y="96" font-family="'Space Grotesk', sans-serif" font-weight="900" font-size="9" fill="#FFFFFF" text-anchor="middle" letter-spacing="0.5">FG COLLEGES</text>
  <text x="60" y="104" font-family="sans-serif" font-weight="700" font-size="6" fill="url(#fgc-gold)" text-anchor="middle" letter-spacing="0.5">ISLAMABAD</text>
</svg>
