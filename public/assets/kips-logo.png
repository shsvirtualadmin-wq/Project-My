<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <linearGradient id="kips-red" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#C8102E"/>
      <stop offset="100%" stop-color="#8B0000"/>
    </linearGradient>
    <linearGradient id="kips-navy" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00205B"/>
      <stop offset="100%" stop-color="#001030"/>
    </linearGradient>
  </defs>

  <!-- Split Dual-Tone Shield -->
  <path d="M 60,6 C 88,6 102,18 102,46 C 102,80 60,112 60,112 C 60,112 18,80 18,46 C 18,18 32,6 60,6 Z" fill="url(#kips-navy)" stroke="#FFD100" stroke-width="3"/>

  <!-- Left Half Red Overlay -->
  <path d="M 60,6 C 32,6 18,18 18,46 C 18,80 60,112 60,112 Z" fill="url(#kips-red)"/>

  <!-- KIPS Flame & Arrow motif -->
  <g transform="translate(60, 48)">
    <path d="M 0,-24 L 14,0 L 4,0 L 4,16 L -4,16 L -4,0 L -14,0 Z" fill="#FFD100"/>
    <!-- STEP Star -->
    <polygon points="0,-16 2.5,-10 8.5,-10 3.5,-6.5 5.5,0 0,-4 -5.5,0 -3.5,-6.5 -8.5,-10 -2.5,-10" fill="#FFFFFF"/>
  </g>

  <!-- KIPS STEP Text -->
  <text x="60" y="94" font-family="'Space Grotesk', sans-serif" font-weight="900" font-size="12" fill="#FFFFFF" text-anchor="middle" letter-spacing="1">KIPS</text>
  <text x="60" y="104" font-family="sans-serif" font-weight="800" font-size="7" fill="#FFD100" text-anchor="middle" letter-spacing="0.5">STEP PREP</text>
</svg>
