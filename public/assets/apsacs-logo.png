<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <linearGradient id="aps-green" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1E3A1E"/>
      <stop offset="100%" stop-color="#0F200F"/>
    </linearGradient>
    <linearGradient id="aps-gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F2B90C"/>
      <stop offset="100%" stop-color="#C59B27"/>
    </linearGradient>
  </defs>

  <!-- Army Shield -->
  <path d="M 60,6 C 88,6 102,18 102,46 C 102,80 60,112 60,112 C 60,112 18,80 18,46 C 18,18 32,6 60,6 Z" fill="url(#aps-green)" stroke="url(#aps-gold)" stroke-width="3"/>

  <!-- Star & Crescent at top -->
  <path d="M 54,14 A 6,6 0 1,0 62,22 A 8,8 0 1,1 54,14 Z" fill="url(#aps-gold)"/>
  <polygon points="62,16 63.5,18.5 66.5,18.5 64,20 65,22.5 62,21 59,22.5 60,20 57.5,18.5 60.5,18.5" fill="url(#aps-gold)"/>

  <!-- Crossed Swords (Military emblem) & Open Book -->
  <g transform="translate(60, 52)">
    <!-- Sword 1 -->
    <line x1="-20" y1="18" x2="20" y2="-18" stroke="url(#aps-gold)" stroke-width="2.5" stroke-linecap="round"/>
    <!-- Sword 2 -->
    <line x1="20" y1="18" x2="-20" y2="-18" stroke="url(#aps-gold)" stroke-width="2.5" stroke-linecap="round"/>
    
    <!-- Open Book in front of swords -->
    <path d="M -18,6 C -9,2 -3,2 0,4 C 3,2 9,2 18,6 L 18,16 C 9,12 3,12 0,14 C -3,12 -9,12 -18,16 Z" fill="#FFFFFF"/>
    <path d="M 0,4 L 0,14" stroke="url(#aps-gold)" stroke-width="1.5"/>
  </g>

  <!-- Motto Banner -->
  <path d="M 22,86 Q 60,98 98,86 L 94,98 Q 60,110 26,98 Z" fill="url(#aps-gold)"/>
  <text x="60" y="94" font-family="'Space Grotesk', sans-serif" font-weight="900" font-size="7.5" fill="#0F200F" text-anchor="middle" letter-spacing="0.5">APSACS</text>
  <text x="60" y="104" font-family="sans-serif" font-weight="800" font-size="5" fill="#FFFFFF" text-anchor="middle" letter-spacing="0.5">I EXCEL</text>
</svg>
