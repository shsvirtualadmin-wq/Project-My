<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <linearGradient id="opf-blue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1B263B"/>
      <stop offset="100%" stop-color="#0D131D"/>
    </linearGradient>
    <linearGradient id="opf-gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F5A623"/>
      <stop offset="100%" stop-color="#D48806"/>
    </linearGradient>
  </defs>

  <!-- Outer Circle -->
  <circle cx="60" cy="60" r="58" fill="url(#opf-gold)"/>
  <circle cx="60" cy="60" r="52" fill="url(#opf-blue)"/>
  <circle cx="60" cy="60" r="44" fill="none" stroke="url(#opf-gold)" stroke-width="2"/>

  <!-- Globe & Crescent Emblem -->
  <g transform="translate(60, 52)">
    <!-- Globe Lines -->
    <circle cx="0" cy="0" r="22" fill="none" stroke="url(#opf-gold)" stroke-width="2"/>
    <ellipse cx="0" cy="0" rx="22" ry="9" fill="none" stroke="url(#opf-gold)" stroke-width="1.5"/>
    <line x1="0" y1="-22" x2="0" y2="22" stroke="url(#opf-gold)" stroke-width="1.5"/>
    <!-- Crescent wrapping -->
    <path d="M -14,-14 A 20,20 0 1,0 14,14 A 24,24 0 1,1 -14,-14 Z" fill="#00A86B"/>
  </g>

  <!-- OPF Text -->
  <text x="60" y="96" font-family="'Space Grotesk', sans-serif" font-weight="900" font-size="11" fill="#FFFFFF" text-anchor="middle" letter-spacing="1">OPF</text>
  <text x="60" y="104" font-family="sans-serif" font-weight="700" font-size="6" fill="url(#opf-gold)" text-anchor="middle" letter-spacing="0.5">COLLEGES</text>
</svg>
